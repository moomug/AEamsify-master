{
  "version": "1.0",
  "defaultProvider": "cdnjs",
  "libraries": [
    {
      "library": "bootstrap@5.2.0",
      "destination": "wwwroot/lib/bootstrap/",
      "files": [
        "js/bootstrap.min.js",
        "css/bootstrap.rtl.min.css.map",
        "css/bootstrap.rtl.min.css",
        "css/bootstrap.rtl.css.map",
        "css/bootstrap.rtl.css",
        "js/bootstrap.bundle.js",
        "js/bootstrap.bundle.js.map",
        "js/bootstrap.bundle.min.js",
        "js/bootstrap.bundle.min.js.map",
        "css/bootstrap.css",
        "css/bootstrap.css.map",
        "css/bootstrap.min.css",
        "css/bootstrap.min.css.map",
        "js/bootstrap.js.map",
        "js/bootstrap.js",
        "js/bootstrap.min.js.map"
      ]
    },
    {
      "library": "animate.css@4.1.1",
      "destination": "wwwroot/lib/animate.css/",
      "files": [
        "animate.min.css",
        "animate.css"
      ]
    },
    {
      "provider": "unpkg",
      "library": "sweetalert2@11.4.33",
      "destination": "wwwroot/sweetalert2/",
      "files": [
        "dist/sweetalert2.all.js",
        "dist/sweetalert2.all.min.js",
        "dist/sweetalert2.css",
        "dist/sweetalert2.min.css"
      ]
    },
    {
      "library": "bootbox.js@5.5.3",
      "destination": "wwwroot/lib/bootbox.js/"
    },
    {
      "library": "jquery-ajax-unobtrusive@3.2.6",
      "destination": "wwwroot/lib/jquery-ajax-unobtrusive/",
      "files": [
        "jquery.unobtrusive-ajax.min.js",
        "jquery.unobtrusive-ajax.js"
      ]
    },
    {
      "library": "pdfmake@0.2.5",
      "destination": "wwwroot/assets/plugins/datatables/pdfmake/",
      "files": [
        "fonts/Roboto/Roboto-Italic.ttf",
        "fonts/Roboto/Roboto-Medium.ttf",
        "fonts/Roboto/Roboto-MediumItalic.ttf",
        "fonts/Roboto/Roboto-Regular.ttf",
        "vfs_fonts.min.js"
      ]
    }
  ]
}